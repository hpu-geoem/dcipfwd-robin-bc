# Imported target `mfem` from share/mfem/config.mk of an MFEM makefile installation under MFEM_PREFIX.

find_file(MFEM_CONFIG_MK config.mk HINTS "${MFEM_PREFIX}" PATH_SUFFIXES share/mfem NO_DEFAULT_PATH)
if(NOT MFEM_CONFIG_MK)
  message(FATAL_ERROR "MFEM not found: set MFEM_PREFIX (or MFEM_DIR) to an installation with lib/cmake/mfem or "
                      "share/mfem/config.mk.")
endif()

file(READ "${MFEM_CONFIG_MK}" _mfem_mk)
string(REGEX REPLACE "\\\\[ \t]*\n" " " _mfem_mk "${_mfem_mk}")

# Return the value of a make variable with $(MFEM_...) references to earlier variables expanded.
function(_mfem_mk_value name out)
  string(REGEX MATCH "(^|\n)[ \t]*${name}[ \t]*=[ \t]*([^\n]*)" _line "${_mfem_mk}")
  set(_value "${CMAKE_MATCH_2}")
  foreach(_ref MFEM_INC_DIR MFEM_LIB_DIR MFEM_INSTALL_DIR MFEM_TPLFLAGS MFEM_EXT_LIBS)
    if(NOT _ref STREQUAL name AND _value MATCHES "\\$\\(${_ref}\\)")
      _mfem_mk_value(${_ref} _sub)
      string(REPLACE "$(${_ref})" "${_sub}" _value "${_value}")
    endif()
  endforeach()
  string(STRIP "${_value}" _value)
  set(${out} "${_value}" PARENT_SCOPE)
endfunction()

foreach(feature MPI MUMPS GSLIB OPENMP)
  _mfem_mk_value(MFEM_USE_${feature} _use)
  if(_use STREQUAL "YES")
    set(MFEM_USE_${feature} ON)
  else()
    set(MFEM_USE_${feature} OFF)
  endif()
endforeach()

_mfem_mk_value(MFEM_INC_DIR _include_dir)
_mfem_mk_value(MFEM_LIB_FILE _library)
_mfem_mk_value(MFEM_TPLFLAGS _tpl)
_mfem_mk_value(MFEM_EXT_LIBS _ext)
separate_arguments(_tpl UNIX_COMMAND "${_tpl}")
separate_arguments(_ext UNIX_COMMAND "${_ext}")
set(_includes "${_include_dir}")
set(_definitions)
set(_options)
foreach(_flag IN LISTS _tpl)
  if(_flag MATCHES "^-I(.+)$")
    list(APPEND _includes "${CMAKE_MATCH_1}")
  elseif(_flag MATCHES "^-D(.+)$")
    list(APPEND _definitions "${CMAKE_MATCH_1}")
  elseif(_flag MATCHES "^-(f|pthread|std=|m)")
    list(APPEND _options "${_flag}")
  endif()
endforeach()
list(REMOVE_DUPLICATES _includes)

add_library(mfem INTERFACE IMPORTED)
set_target_properties(mfem PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${_includes}" INTERFACE_COMPILE_DEFINITIONS "${_definitions}"
                                      INTERFACE_COMPILE_OPTIONS "${_options}" INTERFACE_LINK_LIBRARIES "${_library};${_ext}")
if(MFEM_USE_OPENMP)
  find_package(OpenMP REQUIRED COMPONENTS CXX)
  target_link_libraries(mfem INTERFACE OpenMP::OpenMP_CXX)
endif()
message(STATUS "MFEM from ${MFEM_CONFIG_MK}: ${_library}")
